# Dev: relative path → Vite dev proxy (/directus → http://localhost:8055)
# Prod (Netlify): relative path → Netlify _redirects proxy (/directus → directus.mlluizdevtech.com.br)
# Direct (bypass proxy): absolute URL if CORS is enabled on Directus server
VITE_DIRECTUS_URL=/directus

# Vite dev server only — proxy target (not used in production)
VITE_DIRECTUS_INTERNAL_URL=https://directus.mlluizdevtech.com.br
